{
  "name": "pp-md",
  "private": true,
  "version": "1.3.9",
  "description": "Power Platform solution documentation generator (standalone Docker web UI).",
  "author": "Mike Hartley",
  "companyName": "Hart of the Midlands",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:contrast": "node scripts/check-contrast.mjs",
    "smoke:doc": "tsx scripts/smoke-doc.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "quality:gate": "npm run lint && npm run test:run && npm run smoke:doc && npm run build && npm run test:a11y",
    "build": "npm run check:contrast && tsc && vite build",
    "build:with-maps": "npm run check:contrast && tsc && vite build --mode debug",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "start": "node server/server.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.11.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mermaid": "^11.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
